---
import { walkTimeFromHeya, HEYA_COORDINATES } from '../../lib/distance';

interface Props {
  coords: { lat: number; lng: number };
  variant?: 'full' | 'compact';
}

const { coords, variant = 'full' } = Astro.props;
const walk = walkTimeFromHeya(coords);
---

<div class={`distance-badge ${variant}`} aria-label="Distance from Heya Hotel">
  <div class="walk">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="13" cy="4" r="2"/>
      <path d="M7 22l3-7 4-2-2-5 3-1 2 5 3 1"/>
    </svg>
    <span>{walk.label}</span>
  </div>
</div>

<style>
  .distance-badge {
    display: inline-flex;
    align-items: center;
    background: var(--color-brand-tint);
    color: var(--color-brand);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .walk {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .distance-badge.compact {
    padding: 4px 10px;
    font-size: var(--fs-xs);
  }
</style>

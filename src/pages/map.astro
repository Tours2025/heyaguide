---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapView from '../components/map/MapView';

const allPois = await getCollection('places');
const url = Astro.url;
const initialCategory = url.searchParams.get('category') ?? undefined;
const initialPlace = url.searchParams.get('place') ?? undefined;

// Serialize POIs into minimal payload (id, coords, name, category, short, hours)
const poisForMap = allPois.map((p) => ({
  data: {
    slug: p.data.slug,
    name: p.data.name,
    category: p.data.category,
    shortDescription: p.data.shortDescription,
    coordinates: p.data.coordinates,
    hours: p.data.hours,
  },
  id: p.id,
  body: p.body,
  collection: 'places',
}));
---

<BaseLayout
  title="Istanbul Map"
  description="Interactive map of Istanbul landmarks, with transit lines, walk-distance rings, and the Heya Hotel pin."
  bodyClass="map-page"
>
  <div class="map-page">
    <header class="map-header">
      <div class="container">
        <p class="eyebrow">Interactive</p>
        <h1>The whole city, on one map.</h1>
        <p class="map-sub">
          Walk-distance rings from Heya, every landmark with one tap to open its details.
        </p>
      </div>
    </header>

    <MapView
      client:only="react"
      pois={poisForMap as any}
      initialCategory={initialCategory}
      initialPlace={initialPlace}
    />
  </div>
</BaseLayout>

<style is:global>
  .map-page main { padding-top: 0; }

  .map-header {
    padding: var(--space-8) 0 var(--space-5);
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-bg-muted);
  }

  .map-header h1 {
    font-size: clamp(2rem, 4vw + 1rem, 3.25rem);
    margin: var(--space-2) 0 var(--space-3);
  }

  .map-sub {
    font-size: var(--fs-md);
    color: var(--color-ink-muted);
    max-width: 60ch;
    margin: 0;
  }

  .map-layout {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .map-shell {
    position: relative;
    height: calc(100dvh - var(--header-height) - 220px);
    min-height: 480px;
    width: 100%;
  }

  .map-canvas {
    position: absolute;
    inset: 0;
  }

  /* Increase specificity to beat MapLibre's .maplibregl-map { position: relative } */
  .map-shell > .map-canvas {
    position: absolute;
    inset: 0;
  }

  /* Floating legend (desktop) — absolute over the map. */
  .map-controls--floating {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 10;
    pointer-events: none;
  }

  /* Mobile legend (below the map) — hidden on desktop, shown on phones. */
  .map-controls--below {
    display: none;
  }

  .control-card {
    background: rgba(255, 255, 255, 0.96);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
    pointer-events: auto;
    min-width: 240px;
  }

  .control-title {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-3);
    font-weight: 600;
  }

  .cat-toggles {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .cat-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    color: var(--color-ink);
    background: transparent;
    transition: background var(--dur-fast) var(--ease-out);
    text-align: left;
    width: 100%;
  }

  .cat-toggle .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    border: 2px solid var(--color-bg-elevated);
    box-shadow: 0 0 0 1px var(--accent);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .cat-toggle.off {
    color: var(--color-ink-subtle);
  }

  .cat-toggle.off .dot {
    opacity: 0.3;
  }

  .cat-toggle:hover {
    background: var(--color-bg-muted);
  }

  .toggles-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-bg-muted);
  }

  .switch {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-ink);
    cursor: pointer;
  }

  .switch input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-brand);
  }

  /* Legend — used by both the floating desktop card and the mobile bar below */
  .legend-simple {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .legend-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-ink);
  }

  .legend-simple-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(20, 34, 46, 0.18);
  }

  .legend-simple-dot--poi {
    background: #1e6b8a;
    border-color: #fff;
  }

  .legend-simple-dot--heya {
    background: #c5a059;
    border-color: #163946;
  }

  .legend-simple-dot--ferry {
    background: #163946;
    border-color: #c5a059;
  }

  .legend-ferry-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--fs-xs);
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: none;
  }

  .legend-ferry-link:hover {
    text-decoration: underline;
  }

  /* Heya pin — a single gold teardrop with the H glyph. The marker is
     positioned by MapLibre at the exact geo-coordinate, so this just
     styles the SVG inside the marker element. */
  .heya-marker {
    cursor: default;
    line-height: 0;
  }
  .heya-marker svg {
    display: block;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }

  /* Popup styling */
  .maplibreg-popup-content.maplibreg-popup-content {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    font-family: var(--font-sans);
  }

  .map-popup .popup-cat {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: white;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .map-popup .popup-title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
  }

  .map-popup .popup-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .map-popup .popup-status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  /* Ferry popup */
  .ferry-popup-note {
    font-size: var(--fs-sm);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-3);
    line-height: 1.5;
  }

  .ferry-popup-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }

  .ferry-popup-dest {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--line);
  }

  .ferry-popup-dest-name {
    font-weight: 600;
    color: var(--color-ink);
    font-size: var(--fs-sm);
    margin-bottom: 2px;
  }

  .ferry-popup-dest-meta {
    font-size: var(--fs-xs);
    color: var(--color-ink-muted);
  }

  /* POI / ferry info card — bottom sheet on mobile, side panel on desktop.
     Replaces the old MapLibre popups (which got blocked by the legend). */
  .poi-info-card {
    position: fixed;
    z-index: 50;
    background: var(--color-bg-elevated);
    box-shadow: 0 -8px 32px rgba(20, 34, 46, 0.18);
    padding: var(--space-4) var(--space-5) var(--space-5);
    max-height: 70dvh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    animation: poi-card-slide-up 280ms var(--ease-out);
  }

  @keyframes poi-card-slide-up {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  /* Mobile-first: bottom sheet pinned to the bottom */
  .poi-info-card {
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .poi-info-card-handle {
    width: 36px;
    height: 4px;
    background: var(--color-line);
    border-radius: 2px;
    margin: 0 auto var(--space-3);
  }

  .poi-info-card-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 32px;
    height: 32px;
    border: none;
    background: var(--color-bg-muted);
    color: var(--color-ink);
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .poi-info-card-close:hover {
    background: var(--color-line);
  }

  .poi-info-card-body {
    padding-right: 32px; /* leave room for the close button */
  }

  .poi-info-card-title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .poi-info-card-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--color-ink-muted);
  }

  .poi-info-card-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .poi-info-card-desc {
    font-size: var(--fs-sm);
    color: var(--color-ink-muted);
    line-height: 1.55;
    margin: 0 0 var(--space-4);
  }

  .poi-info-card-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }

  .poi-info-card-dests {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .poi-info-card-dest {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--line);
  }

  .poi-info-card-dest:first-child {
    border-top: none;
    padding-top: 0;
  }

  .poi-info-card-dest-name {
    font-weight: 600;
    color: var(--color-ink);
    font-size: var(--fs-sm);
    margin-bottom: 2px;
  }

  .poi-info-card-dest-meta {
    font-size: var(--fs-xs);
    color: var(--color-ink-muted);
  }

  .poi-info-card-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-brand);
    color: white;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .poi-info-card-cta:hover {
    background: var(--color-brand-dark, #154e66);
  }

  /* Desktop: side panel on the right instead of bottom sheet */
  @media (min-width: 721px) {
    .poi-info-card {
      left: auto;
      right: var(--space-4);
      bottom: var(--space-4);
      top: var(--space-4);
      max-width: 380px;
      max-height: none;
      border-radius: var(--radius-lg);
      animation: poi-card-slide-left 280ms var(--ease-out);
    }
    @keyframes poi-card-slide-left {
      from { transform: translateX(120%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    .poi-info-card-handle {
      display: none;
    }
  }

  .map-popup .popup-desc {
    font-size: var(--fs-sm);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
    line-height: var(--lh-normal);
  }

  .map-popup .popup-cta {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-brand);
    text-decoration: none;
  }

  .map-popup .popup-cta:hover {
    color: var(--color-brand-strong);
  }

  /* POI labels removed — only the blue dots are shown on the map. Names
     still appear when the user taps/clicks a dot via the popup. */

  @media (max-width: 720px) {
    /* On phones: hide the floating legend overlay; show the dedicated
       mobile legend block that lives in normal flow below the map. This
       way the legend never blocks pinch/pan gestures on the map. */
    .map-shell {
      height: calc(100dvh - var(--header-height) - 220px);
      min-height: 420px;
    }

    .map-controls--floating {
      display: none;
    }

    .map-controls--below {
      display: block;
      margin: var(--space-3) var(--space-3) var(--space-5);
      width: auto;
    }

    .map-controls--below .control-card {
      min-width: 0;
      width: 100%;
      padding: var(--space-3) var(--space-4);
    }

    .legend-simple--inline {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-4);
    }

    .legend-simple--inline .legend-row {
      flex: 0 0 auto;
    }

    .switch--inline {
      flex: 0 0 auto;
      margin-left: auto;
      border-left: 1px solid var(--line);
      padding-left: var(--space-4);
    }
  }
</style>

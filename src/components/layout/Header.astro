---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/map', label: 'Map' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="HeyaGuide — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28">
          <path d="M16 4 L26 12 L24 26 L8 26 L6 12 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="16" cy="18" r="3" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">HeyaGuide</span>
        <span class="brand-tagline">Your Istanbul companion</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="mobile-toggle no-print" aria-label="Open menu" aria-expanded="false" data-mobile-toggle>
      <span class="hamburger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="mobile-menu no-print" data-mobile-menu hidden>
    <ul>
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['mobile-link', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: rgba(247, 243, 236, 0.85);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid rgba(20, 34, 46, 0.06);
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-brand);
    text-decoration: none;
  }

  .brand-mark {
    color: var(--color-brand);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .brand-tagline {
    font-size: var(--fs-xs);
    color: var(--color-ink-muted);
    margin-top: 2px;
    letter-spacing: var(--tracking-wide);
  }

  .site-nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
  }

  .site-nav li { margin: 0; }

  .nav-link {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    padding: var(--space-2) 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active { color: var(--color-ink); }

  .nav-link.active::after { transform: scaleX(1); }

  .mobile-toggle {
    display: none;
    padding: var(--space-2);
  }

  .hamburger {
    display: inline-block;
    width: 24px;
    height: 18px;
    position: relative;
  }

  .hamburger span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-ink);
    border-radius: 1px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .hamburger span:nth-child(1) { top: 0; }
  .hamburger span:nth-child(2) { top: 50%; transform: translateY(-50%); }
  .hamburger span:nth-child(3) { bottom: 0; }

  .mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle[aria-expanded="true"] .hamburger span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    background: var(--color-bg);
    z-index: 99;
    padding: var(--space-7) var(--container-pad);
    transform: translateX(100%);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .mobile-menu[data-open="true"] {
    transform: translateX(0);
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-link {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--space-3) 0;
    display: block;
    border-bottom: 1px solid var(--color-bg-muted);
  }

  .mobile-link.active {
    color: var(--color-brand);
  }

  @media (max-width: 720px) {
    .site-nav { display: none; }
    .mobile-toggle { display: inline-flex; }
    .brand-tagline { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      if (!isOpen) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.setAttribute('data-open', 'true'));
      } else {
        menu.removeAttribute('data-open');
        setTimeout(() => { menu.hidden = true; }, 320);
      }
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.removeAttribute('data-open');
        setTimeout(() => { menu.hidden = true; }, 320);
      }),
    );
  }
</script>
